# Local development: use a real local password.
DATABASE_URL=postgresql://onlymarket:CHANGE_ME@localhost:5432/onlymarket
# Compose: generate 32 random bytes as hex; do not include punctuation in this URL password.
POSTGRES_PASSWORD=CHANGE_ME
# Domain routing (configurable without code changes for future standalone product domains)
PLATFORM_DOMAIN=onlymarket.nanoapps.ar
TENANT_BASE_DOMAIN=nanoapps.ar
# Explicitly empty for isolated local tests; do not point to production.
NANOAPPS_ROUTER_URL=http://nanoapps-router:8080
EXTERNAL_SAAS_ASK_URLS=
TENANT_URL_SCHEME=
TENANT_URL_PORT=
# Shared domains require the existing router; exclusive is only for a separately owned domain.
TENANT_NAMESPACE_MODE=shared
RESERVED_SLUGS=
# Platform admin (/superadmin on PLATFORM_DOMAIN) and read-only Hub integration
PLATFORM_ADMIN_ENABLED=false
HUB_INTEGRATION_TOKEN=
